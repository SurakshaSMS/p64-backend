# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on
PORT=5000

# Long random secret used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login token stays valid (e.g. 1h, 7d)
JWT_EXPIRES_IN=7d

# Firebase: place the service-account JSON in the repo root as
# p64-surakshasms-firebase-adminsdk-fbsvc-b251ec8c62.json (see README section 3)
